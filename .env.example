# Copy to `.env` for local dev, and set the same in Vercel → Project → Settings →
# Environment Variables for the deployed site. Never commit your real key.

# Required for "Play with AI" — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: which model to use (default: openai/gpt-oss-20b:free)
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional, only for running AI mode in Expo Go on a phone: your deployed origin
# so the app can reach /api/generate. Not needed for the web version.
# EXPO_PUBLIC_API_ORIGIN=https://breaking-bad-trivia-app.vercel.app
